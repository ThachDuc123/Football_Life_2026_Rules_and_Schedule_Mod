    "\x48\x83\xcb\xff" ..
    "\x48\xbe\x67\x66\x66\x66\x66\x66\x66\x66"

-- rankingGroupLeaguePes::next_group. R1 calls this with the live controller
-- object in RCX, even when the post-match screen cannot be closed with B.
local snapshot_original =
    "\x53" ..
    "\x48\x83\xec\x20" ..
    "\x8b\x81\x90\x00\x00\x00" ..
    "\x48\x8b\xd9"

