--[[
UCL Master League schedule probe
Status: experimental / read-only

Purpose:
- observe which teams/tournament IDs PES 2021/Football Life exposes
- observe Master League schedule-bar entries
- produce a CSV log before any fixture modification is attempted

This module does NOT attempt to change teams, fixtures, standings, dates,
or match settings.

Enable in sider.ini:
    lua.module = "ucl_schedule_probe.lua"

Output:
    ucl_ml_probe.csv

Reference:
https://github.com/pes-modding/sider7/blob/master/doc/scripting.html
--]]

-- Sider's sandbox exposes these LuaJIT extensions directly when
-- luajit.ext.enabled=1; it intentionally does not expose require().
local ffi = ffi
local bit = bit

local m = { version = "0.22.4" }
local merge_enabled = true
local native_controller_route_enabled = false
local output_path = ".\\ucl_ml_probe.csv"
local menu_output_path = ".\\ucl_menu_files.log"
local ranking_output_path = ".\\ucl_ranking_probe.log"
local match_block_cache_path = ".\\ucl_match_block.cache"
local ranking_team_capture_path = ".\\ucl_capture_rankingTeam.bin"
local ranking_group_stock_size = 12729
-- The resource is identified by what it is, not by how many bytes it packs
-- into. 12729 is Konami's stock rankingGroupLeaguePes, the only build that
-- stops at choice_9; asking it for choice_10 crashes the renderer, so that one
-- size is the whole guard. Anything else reaching this callback came from our
-- livecpk root and therefore exposes choice_0..choice_15.
--
-- Keying on an exact patched size was a mistake that cost two sessions: WESYS
-- deflates the resource, so every rebuild lands on a different byte count, and
-- a module still in memory from before the rebuild would reject the new file
-- and silently fall back to the eight native groups.
local ranking_group_resource_safe = false
local ranking_group_layout_rows = 0
local seen_schedule = {}
local seen_menu_files = {}
local seen_input_objects = {}
local snapshot_hook_addr
local snapshot_hook_armed = false
local merge_hook_addr
local destructor_hook_addr
local captured_object
local active_object
local saved_object_state
local merged_records_addr
local merged_outer_addr
local scroll_handled_addr
local ranking_refresh_addr
local window_ledger_addr
local title_call_addr
local title_stub_addr
local title_buffer_addr
local global_input_hook_addr = 0x140e411e0
local ranking_team_render_addr = 0x140aedf80
local seen_ranking_team_rows = {}
local ranking_controller_factory_call_addr = 0x140af95a7
local ranking_controller_factory_call_pes_addr = 0x140af95c7
local ranking_team_factory_addr = 0x140aed610
local ranking_group_factory_call_original = "\xe8\x74\xb8\xff\xff"
local ranking_team_factory_call_patch = "\xe8\x64\x40\xff\xff"
local ranking_group_factory_pes_call_original = "\xe8\xe4\xb7\xff\xff"
local ranking_team_factory_pes_call_patch = "\xe8\x44\x40\xff\xff"
local ranking_group_wrapper_tail_addr = 0x140af4ed0
local ranking_group_wrapper_pes_tail_addr = 0x140af4ef2
local ranking_group_wrapper_tail_original = "\xe9\x4b\xff\xff\xff"
local ranking_group_wrapper_pes_tail_original = "\xe9\xb9\xfe\xff\xff"
local ranking_team_wrapper_tail_patch = "\xe9\x3b\x87\xff\xff"
local ranking_team_wrapper_pes_tail_patch = "\xe9\x19\x87\xff\xff"
local league_records = {}
-- Clubs in the merged table: 32 (8 groups of 4) or 36 (UEFA 2024+ league
-- phase: the regulation in livecpk/UEFA36 makes 4 groups of 9). league_comp is
-- the competition whose results fill it: 3 = Champions League, 5 = Europa League.
local league_total = 32
local league_comp = 3
local max_league_pages = 36
local window_start = 0
local visible_rows = 16
local max_visible_rows = 16
-- One outer-vector entry per window position: 32 teams shown 16 at a time
-- gives 17 stops (1-16, 2-17, ... 17-32). Declaring that many pages hands the
-- scrolling to the game's own pager, which already knows how to repopulate the
-- list on its own thread. Every entry points at the same inner buffer; the
-- repopulate hook fills it for whichever page the game just moved to.
local league_page_count = 32 - max_visible_rows + 1
local refresh_hook_addr
local group_previous_hook_addr
-- prev_group's first 15 bytes, read out of the running process by v0.16.0:
-- push rbx / sub rsp,20 / mov eax,[rcx+90] / mov rbx,rcx. Fifteen bytes is
-- both an instruction boundary and enough room for the 14-byte detour.
local group_previous_original = string.char(
    0x40, 0x53, 0x48, 0x83, 0xec, 0x20, 0x8b, 0x81,
    0x90, 0x00, 0x00, 0x00, 0x48, 0x8b, 0xd9
)
local scroll_league_window
local set_league_page
-- Bounded diagnostics. The repopulate hook fires for every standings screen in
-- the game, so it may only ever log a fixed number of first sightings; an
-- unbounded probe here writes megabytes and buries the events that matter.
local seen_refresh_objects = {}
local refresh_probe_budget = 12
local render_probe_budget = 12
local overlay_dpad_state = 0
local overlay_lb_state = 0
local overlay_rb_state = 0
local native_refresh_fn
local refresh_pending = false
local refresh_due_clock = 0
local refresh_debounce_seconds = 0.20

local function schedule_refresh()
    refresh_pending = true
    refresh_due_clock = os.clock() + refresh_debounce_seconds
end

local merge_original =
    "\x49\x8b\x85\xa8\x00\x00\x00" ..
    "\x49\x39\x85\xa0\x00\x00\x00"

