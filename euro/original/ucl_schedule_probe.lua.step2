local destructor_original =
    "\x48\x89\x5c\x24\x08" ..
    "\x57" ..
    "\x48\x83\xec\x20" ..
    "\x48\x8d\x05\xd7\x13\xb9\x01"

local destructor_anchor =
    destructor_original ..
    "\x48\x8b\xf9\x48\x89\x01\x8b\xda"

local destructor_stale_prefix =
    "\x48\x8b\xcf\xe8\x88\xbb\x1a\x00" ..
    "\xf6\xc3\x01\x74\x0d\xba\xd0\x00\x00\x00" ..
    "\x48\x8b\xcf\xe8\xf6\x2b\x73\xff" ..
    "\x48\x8b\xc7\x48\x8b\x5c\x24\x30" ..
    "\x48\x83\xc4\x20\x5f\xc3" ..
    "\xcc\xcc\xcc\xcc\xcc\xcc\xcc\xcc"

-- Callback table used by rankingGroupLeaguePes. The final two entries are the
-- native previous/next-group handlers and remain stable while the directional
-- entries are redirected.
local input_vtable_tail =
    "\xc0\x6a\xaf\x40\x01\x00\x00\x00" ..
    "\x40\x6b\xaf\x40\x01\x00\x00\x00"

-- FL_2026 action callbacks: 1=confirm, 2=cancel, 4=up, 5=down.
-- v0.9.0 incorrectly hooked actions 1/2, which made Circle/Back scroll and
-- trapped the user in the ranking screen. Keep those legacy values solely so
